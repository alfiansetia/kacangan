---
export interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props as Props;
const siteUrl = 'https://kacangan.net';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: item.href ? new URL(item.href, siteUrl).href : undefined,
  })),
};
---
<nav aria-label="Breadcrumb" class="text-sm text-slate-500">
  <ol class="flex flex-wrap gap-1">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {item.href ? <a href={item.href} class="hover:text-primary hover:underline">{item.label}</a> : <span class="font-medium text-slate-700">{item.label}</span>}
        {i < items.length - 1 && <span class="text-slate-300">/</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
