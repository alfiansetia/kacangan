---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = 'Template Hotspot MikroTik — Desain Modern & Responsive | KCNET';
const description = 'Template hotspot MikroTik modern, mobile-friendly, mudah kustomisasi untuk warnet, cafe, RT/RW Net, sekolah & kantor. Support Mikrotik RouterOS. Hubungi WA 082324129752.';
const keywords = 'template hotspot mikrotik, login page hotspot, hotspot mikrotik keren, mikrotik hotspot template';

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Apa itu Template Hotspot KCNET?", "acceptedAnswer": { "@type": "Answer", "text": "Template hotspot KCNET adalah halaman login hotspot MikroTik dengan desain modern, responsif, dan mudah dikustomisasi untuk warnet, cafe, RT/RW Net, sekolah dan kantor." } },
    { "@type": "Question", "name": "Apakah cocok untuk pemula?", "acceptedAnswer": { "@type": "Answer", "text": "Sangat cocok. Tidak perlu keahlian coding mendalam — tinggal upload ke MikroTik dan sesuaikan logo/warna. Cocok untuk non-teknisi maupun desainer." } },
    { "@type": "Question", "name": "Kenapa pilih template hotspot KCNET?", "acceptedAnswer": { "@type": "Answer", "text": "Interface minimalis & mudah dipakai, mobile-friendly out-of-the-box, blok website terbaru, dan gratis untuk komersial & non-profit." } }
  ]
};
---

<BaseLayout title={title} description={description} keywords={keywords} jsonLd={faqJsonLd}>
  <section class="relative overflow-hidden bg-slate-950 py-14 text-white">
    <div class="absolute inset-0 opacity-20" style="background-image:url(/assets/images/background4.jpg);background-size:cover;background-position:center"></div>
    <div class="container-narrow relative">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Layanan', href: '/layanan/' }, { label: 'Template Hotspot' }]} />
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-tight">Template Hotspot MikroTik Modern & Responsif</h1>
      <p class="mt-3 max-w-2xl text-white/70">Tampilkan halaman login yang profesional untuk pelanggan WiFi Anda. Ringan, mobile-friendly, dan mudah dikustomisasi tanpa ribet coding.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://wa.me/6282324129752?text=Saya%20ingin%20template%20hotspot%20MikroTik" class="btn btn-primary">Pesan via WhatsApp</a>
        <a href="/layanan/" class="btn btn-ghost border border-white/20 text-white">Lihat Layanan Lain</a>
      </div>
    </div>
  </section>

  <section class="container-narrow py-12">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl border p-6"><h3 class="font-semibold">Desain Minimalis</h3><p class="mt-2 text-sm text-slate-600">Antarmuka bersih, fokus pada kemudahan login voucher/member.</p></div>
      <div class="rounded-2xl border p-6"><h3 class="font-semibold">Mobile-First</h3><p class="mt-2 text-sm text-slate-600">Tampil sempurna di HP, tablet, dan desktop — teknik terbaru out-of-the-box.</p></div>
      <div class="rounded-2xl border p-6"><h3 class="font-semibold">Mudah Kustom</h3><p class="mt-2 text-sm text-slate-600">Ganti logo, warna, dan teks tanpa pusing code. Upload langsung ke MikroTik.</p></div>
    </div>
    <div class="mt-10 overflow-hidden rounded-2xl border bg-slate-50 p-6 text-center text-sm text-slate-600">
      Cocok untuk: Warnet • Hotspot Corner • RT/RW Net • Kantor • Sekolah • Cafe & Resto
    </div>
  </section>

  <section class="bg-slate-50 py-12">
    <div class="container-narrow max-w-3xl">
      <h2 class="text-center text-2xl font-bold">FAQ</h2>
      <div class="mt-8 space-y-4">
        <details class="rounded-xl border bg-white p-5 open:ring-1 open:ring-primary/20"><summary class="cursor-pointer font-semibold">Apa itu Template Hotspot KCNET?</summary><p class="mt-3 text-sm leading-relaxed text-slate-600">Template hotspot KCNET adalah halaman login hotspot MikroTik dengan desain modern dan responsif. Dibuat untuk memudahkan pembuatan landing login bagi warnet, cafe, RT/RW Net, sekolah, dan kantor.</p></details>
        <details class="rounded-xl border bg-white p-5 open:ring-1 open:ring-primary/20"><summary class="cursor-pointer font-semibold">Apakah cocok untuk pemula?</summary><p class="mt-3 text-sm leading-relaxed text-slate-600">Ya. Cocok untuk non-teknisi yang tidak familiar dengan web development dan untuk desainer yang ingin kerja visual tanpa melawan code. Juga bagus untuk pro-coder untuk prototyping cepat.</p></details>
        <details class="rounded-xl border bg-white p-5 open:ring-1 open:ring-primary/20"><summary class="cursor-pointer font-semibold">Kenapa pilih KCNET?</summary><p class="mt-3 text-sm leading-relaxed text-slate-600">Perbedaan utama: interface minimalis & sangat mudah dipakai, mobile-friendliness & blok website terbaru out-of-the-box, gratis untuk komersial dan non-profit.</p></details>
      </div>
      <p class="mt-6 text-center text-sm text-slate-600">Ada pertanyaan lain? <a href="https://wa.me/6282324129752?text=Saya%20ingin%20bertanya%20tentang%20Template%20Hotspot" class="font-semibold text-primary underline">Hubungi Kami via WhatsApp</a>.</p>
    </div>
  </section>

  <section class="container-narrow py-10 text-center">
    <h2 class="text-xl font-bold">Siap Percantik Halaman Login Hotspot Anda?</h2>
    <a href="https://wa.me/6282324129752?text=Saya%20ingin%20order%20Template%20Hotspot%20MikroTik" class="btn btn-primary mt-4">Chat Sekarang — 0823-2412-9752</a>
  </section>
</BaseLayout>
