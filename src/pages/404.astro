---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Halaman Tidak Ditemukan | KCNET" description="Halaman tidak ditemukan. Kembali ke beranda KCNET untuk layanan VPN Remote, Cloud Userman, dan Jasa Setting MikroTik." noindex={true}>
  <section class="container-narrow flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="text-sm font-semibold tracking-widest text-primary">404</p>
    <h1 class="mt-2 text-4xl font-extrabold">Halaman Tidak Ditemukan</h1>
    <p class="mt-3 max-w-lg text-slate-600">URL yang Anda cari tidak tersedia atau sudah dipindahkan. Coba kembali ke beranda atau hubungi kami via WhatsApp.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Kembali ke Beranda</a>
      <a href="https://wa.me/6282324129752?text=Halo%20KCNET%2C%20saya%20tidak%20menemukan%20halaman%20yang%20saya%20cari" class="btn btn-ghost border">Hubungi WA</a>
    </div>
    <div class="mt-10 flex flex-wrap justify-center gap-2 text-sm">
      <a href="/vpn-remote/" class="rounded-full border px-4 py-2 hover:bg-slate-50">VPN Remote</a>
      <a href="/cloud-userman/" class="rounded-full border px-4 py-2 hover:bg-slate-50">Cloud Userman</a>
      <a href="/layanan/" class="rounded-full border px-4 py-2 hover:bg-slate-50">Layanan</a>
      <a href="/pembayaran/" class="rounded-full border px-4 py-2 hover:bg-slate-50">Pembayaran</a>
    </div>
  </section>
</BaseLayout>
